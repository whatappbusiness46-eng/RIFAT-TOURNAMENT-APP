{
  "expo": {
    "name": "ZYROX ARENA",
    "slug": "zyrox-arena",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "android": {
      "package": "com.zyroxarena.mobile",
      "versionCode": 1,
      "permissions": [
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.VIBRATE"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/zyrox-app-icon.png",
        "backgroundColor": "#07111f"
      }
    },
    "extra": {
      "apiUrl": "https://rifat-tournament-app.onrender.com",
      "eas": {
        "projectId": "f06e9840-171f-4a3c-a45c-f9423b457ab8"
      }
    },
    "icon": "./assets/zyrox-app-icon.png",
    "ios": {
      "bundleIdentifier": "com.zyroxarena.mobile"
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "icon": "./assets/zyrox-app-icon.png",
          "color": "#07111f",
          "defaultChannel": "match-reminders"
        }
      ]
    ]
  }
}
